{
  "doctype": "DocType",
  "name": "Stock Transfer Ticket",
  "module": "Inventory",
  "document_type": "Document",
  "autoname": "format:STT-{YYYY}-{#####}",
  "allow_import": 1,
  "track_changes": 1,
  "index_web_pages_for_search": 1,
  "engine": "InnoDB",
  "is_submittable": 0,
  "field_order": [
    "from_warehouse",
    "to_warehouse",
    "column_break_1",
    "status",
    "stock_entry",
    "section_break_item",
    "item_code",
    "qty",
    "uom",
    "section_break_timestamps",
    "dispatched_on",
    "column_break_2",
    "received_on",
    "section_break_report",
    "report_reason"
  ],
  "fields": [
    {
      "fieldname": "from_warehouse",
      "fieldtype": "Link",
      "label": "From Warehouse",
      "options": "Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "to_warehouse",
      "fieldtype": "Link",
      "label": "To Warehouse",
      "options": "Warehouse",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "\nPending Pickup\nIn Transit\nReceived\nReported\nCancelled",
      "default": "Pending Pickup",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "stock_entry",
      "fieldtype": "Link",
      "label": "Stock Entry",
      "options": "Stock Entry",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "section_break_item",
      "fieldtype": "Section Break",
      "label": "Item"
    },
    {
      "fieldname": "item_code",
      "fieldtype": "Link",
      "label": "Item",
      "options": "Item",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "qty",
      "fieldtype": "Float",
      "label": "Qty",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "uom",
      "fieldtype": "Link",
      "label": "UOM",
      "options": "UOM",
      "fetch_from": "item_code.stock_uom",
      "read_only": 1
    },
    {
      "fieldname": "section_break_timestamps",
      "fieldtype": "Section Break",
      "label": "Timestamps",
      "collapsible": 1
    },
    {
      "fieldname": "dispatched_on",
      "fieldtype": "Datetime",
      "label": "Dispatched On",
      "read_only": 1
    },
    {
      "fieldname": "column_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "received_on",
      "fieldtype": "Datetime",
      "label": "Received On",
      "read_only": 1
    },
    {
      "fieldname": "section_break_report",
      "fieldtype": "Section Break",
      "label": "Report",
      "collapsible": 1
    },
    {
      "fieldname": "report_reason",
      "fieldtype": "Small Text",
      "label": "Report Reason"
    }
  ],
  "permissions": [
    {
      "create": 1,
      "delete": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "share": 1,
      "write": 1,
      "role": "System Manager"
    },
    {
      "create": 1,
      "email": 1,
      "export": 1,
      "print": 1,
      "read": 1,
      "report": 1,
      "share": 1,
      "write": 1,
      "role": "All"
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}


